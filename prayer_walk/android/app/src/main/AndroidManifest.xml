<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Route recording. FINE/COARSE are what the walker is asked for first and
         what every walk actually runs on. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- RECORDING IN A POCKET

         The mechanism that keeps a walk alive with the screen locked is the
         **foreground service**, not ACCESS_BACKGROUND_LOCATION. A service typed
         `location`, started while the app is on screen, may read location for as
         long as it runs on nothing more than ACCESS_FINE_LOCATION. That is what
         the persistent notification is for, and it is the whole of the
         locked-screen story on a phone that behaves.

         ACCESS_BACKGROUND_LOCATION is the resilience layer on top: it is what
         lets the service keep reading if Android tears the process down and
         restarts it, and it is requested separately, later, and only when
         somebody starts a walk — see `LocationService.requestBackgroundAccess`.
         A refusal costs nothing on an ordinary walk.

         Declaring it is not free. It is what puts this app into Google Play's
         background-location declaration and review process, which adds weeks to
         a release. See docs/background_tracking.md — removing this one line is
         the supported way to opt out of that review, at the cost of the
         process-restart case. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Android 13+ will not *display* the foreground-service notification
         without this, and a foreground service the walker cannot see is both a
         support problem and a store-review one. Requested at the same moment as
         the walk, never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- A PARTIAL_WAKE_LOCK held for the length of a recording, and released
         with it. Without it Doze batches fixes and hands them over in a clump
         when the device next wakes, which reads on screen as a walk that
         stopped and then teleported. Acquired by the geolocator service only
         when `enableWakeLock` is set, which this app only sets while
         recording. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Step-paced scripture on the trail, and nothing else. Declared here
         because Android requires it declared, but it is only ever *requested*
         from StepCadenceTrigger, which is only constructed when the walker has
         chosen step cadence. A walker who leaves the default (distance) alone
         is never asked for it. The device is marked as not requiring a step
         sensor so handsets without one still see the app on Play. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false"/>
    <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false"/>

    <!-- Profile photos, from Edit profile and nowhere else.

         CAMERA is declared but never *required*: `image_picker` hands the shot
         off to whatever camera app is installed rather than opening one itself,
         so a device without a camera should still install and still be able to
         pick from the library. Hence `required="false"` below — without it,
         Play hides the app from tablets that have no rear camera.

         There is deliberately no READ_EXTERNAL_STORAGE or READ_MEDIA_IMAGES
         here. `image_picker` uses the system photo picker, which returns one
         file the person chose and grants access to that file alone. Asking for
         the library permission would let this app read every photo on the
         device, to do a job that needs exactly one — and would put a
         "Photos and videos" line on the store listing of a walking app. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>

    <application
        android:label="Prayer Walk"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link so email confirmation / password reset return to the
                 app. Must match the Supabase Redirect URL
                 com.calledpresentations.prayer_walk://login-callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.calledpresentations.prayer_walk" android:host="login-callback" />
            </intent-filter>
        </activity>
        <!-- The recording service, declared here as well as in geolocator's own
             manifest. The merged result is identical either way; what this buys
             is that the one thing a store reviewer and the next maintainer need
             to see — a service typed `location`, and only that type — is in
             *this* app's manifest rather than a transitive dependency's.

             `tools:replace` is what makes that true rather than decorative.
             Without it the merger *unions* the two declarations and emits
             foregroundServiceType="location|location", which compiles to the
             same thing but reads like a mistake in exactly the file somebody is
             auditing. With it, this app's declaration is the one that survives —
             so if a future geolocator ever widened the type, this line would
             still be the truth. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"
            tools:replace="android:foregroundServiceType" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
